flowchart LR
    subgraph App["Application"]
        SDK["Client SDK<br/>encrypts inputs, unseals results"]
    end

    subgraph Host["Host chain"]
        FS["FHE.sol<br/>your contract's FHE library"]
        TM["TaskManager<br/>gateway for FHE requests"]
        ACL["ACL<br/>who may use each handle"]
        PS["PlaintextsStorage<br/>published decrypted results"]
    end

    PRT["Partners<br/>independent key custodians"]

    subgraph CoFHE["CoFHE"]
        ZK["ZK Verifier<br/>verifies input proofs in a TEE"]
        TEE["Teecryptor<br/>decrypts inside a TEE"]
        CTS[("Ciphertext store<br/>every ciphertext, via the CT Server")]
        ENG["Compute pipeline<br/>runs and commits FHE operations"]
    end

    subgraph Registry["Registry chain"]
        CR["CommitmentRegistry<br/>a commitment per ciphertext"]
    end

    SDK --> FS
    FS --> TM
    TM --> ACL
    TM --> PS
    TM --> ENG
    PRT --> ZK
    PRT --> TEE
    ZK --> CTS
    TEE --> CTS
    ENG --> CTS
    ENG --> CR
    TEE --> CR
